{
  "name": "link-flame",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:release": "npm run check:prod-env && npm run check:stripe-config && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "design:check": "node scripts/check-design-system.mjs",
    "check:prod-env": "node scripts/check-production-env.mjs",
    "check:stripe-config": "node scripts/check-stripe-config.mjs",
    "check:csp-hashes": "node scripts/check-csp-hashes.mjs",
    "preflight:production": "npm run check:prod-env && npm run check:stripe-config && npm run lint && npm run test:unit && npm run build && npm run check:csp-hashes",
    "postinstall": "node scripts/prisma-wasm-base64.js && prisma generate",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:coverage": "vitest run -c vitest.integration.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "node scripts/run-e2e-with-pass-rate.mjs 90",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "analyze": "ANALYZE=true next build",
    "brand:generate": "node scripts/generate-brand.mjs",
    "lighthouse:ci": "node scripts/check-lighthouse-score.mjs http://127.0.0.1:3000 / /products /blogs /guides-and-tips /about-us"
  },
  "overrides": {
    "qs": "6.16.0",
    "js-yaml@3": "3.15.2",
